{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhizReveal",
  "version": "1.2.0",
  "identifier": "com.jaycee.whizreveal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "controller",
        "title": "WhizReveal - Controller",
        "width": 1280,
        "height": 850,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0B0D10",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Native raffle controller and fullscreen presentation display",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../public/fonts/aeonik/Aeonik-Regular.ttf": "fonts/Aeonik-Regular.ttf",
      "../public/fonts/aeonik/Aeonik-Medium.ttf": "fonts/Aeonik-Medium.ttf",
      "../public/fonts/aeonik/Aeonik-Bold.ttf": "fonts/Aeonik-Bold.ttf",
      "../docs/font-license.md": "fonts/font-license.md"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/font-hooks.nsh",
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
